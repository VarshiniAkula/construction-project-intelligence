# ─── Application ───────────────────────────────────────────
APP_ENV=production
SECRET_KEY=change-me-to-a-random-64-char-string

# ─── Database (Supabase) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres.dnyrppnwrclstexjlwpk:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ─── Supabase Storage ─────────────────────────────────────
STORAGE_BACKEND=supabase
SUPABASE_URL=https://dnyrppnwrclstexjlwpk.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=documents

# ─── CORS ──────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# ─── AI Provider ──────────────────────────────────────────
# Options: "groq" (free), "anthropic", or "openai"
LLM_PROVIDER=groq

# Groq free-tier LLM (get key at https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Anthropic (Claude) — optional
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VISION_MODEL=claude-sonnet-4-20250514

# ─── Embeddings (local = no API key needed) ───────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ─── Reranker (local = no API key needed) ─────────────────
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-render-app.onrender.com
