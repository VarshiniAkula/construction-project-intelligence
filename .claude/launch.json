{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": false,
      "cwd": "apps/web"
    },
    {
      "name": "api",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "port": 8000,
      "autoPort": false,
      "cwd": "apps/api",
      "env": {
        "PYTHONPATH": ".:../../packages/shared/python"
      }
    }
  ]
}
